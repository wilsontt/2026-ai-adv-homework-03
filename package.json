{
  "name": "backend-project",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run css:build && node server.js",
    "dev:server": "node server.js",
    "dev:css": "npx @tailwindcss/cli -i public/css/input.css -o public/css/output.css --watch",
    "css:build": "npx @tailwindcss/cli -i public/css/input.css -o public/css/output.css --minify",
    "openapi": "node generate-openapi.js",
    "postman": "node generate-postman.js",
    "test:unit": "vitest run tests/shipping.test.js",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^5.0.1",
    "express": "~4.16.1",
    "jsonwebtoken": "^9.0.2",
    "swagger-parser": "^10.0.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "openapi-to-postmanv2": "^6.3.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.2",
    "vitest": "^2.1.9"
  }
}
